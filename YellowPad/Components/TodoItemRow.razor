<li class="todo-row @(Item.IsCompleted ? "is-completed" : null)">
    <button type="button"
            class="completion-button"
            disabled="@Disabled"
            aria-label="@(Item.IsCompleted ? "Mark task incomplete" : "Complete task")"
            @onclick="ToggleAsync">
        <span aria-hidden="true">@(Item.IsCompleted ? "✓" : "○")</span>
    </button>

    @if (_isEditing)
    {
        <label class="visually-hidden" for="edit-task-@Item.Id">Edit task</label>
        <input id="edit-task-@Item.Id"
               @ref="_editor"
               class="paper-input edit-task-input task-color-@Item.Color.ToString().ToLowerInvariant()"
               maxlength="500"
               autocomplete="off"
               spellcheck="true"
               @bind="_editTitle"
               @bind:event="oninput"
               @onkeydown="HandleEditKeyDown"
               @onblur="SaveOnBlurAsync" />
    }
    else
    {
        <button type="button"
                @ref="_titleButton"
                class="task-title task-color-@Item.Color.ToString().ToLowerInvariant()"
                aria-label="Edit task: @Item.Title"
                title="Double-click to edit; right-click to change color"
                @onclick="HandleTitleClick"
                @onkeydown="HandleTitleKeyDown"
                @oncontextmenu="OpenColorMenu"
                @oncontextmenu:preventDefault>@Item.Title</button>
    }

    <button type="button"
            class="delete-task-button"
            disabled="@Disabled"
            aria-label="Delete task"
            @onclick="DeleteAsync">×</button>
@if (_showColorMenu)
{
    <div class="color-menu-dismiss" @onclick="CloseColorMenu" @oncontextmenu="CloseColorMenu" @oncontextmenu:preventDefault></div>
    <div class="task-color-menu" role="group" aria-label="Task text color" tabindex="-1" @ref="_colorMenu"
         style="left: min(@(_menuX.ToString(System.Globalization.CultureInfo.InvariantCulture))px, calc(100vw - 176px)); top: min(@(_menuY.ToString(System.Globalization.CultureInfo.InvariantCulture))px, calc(100vh - 220px))"
         @onkeydown="HandleColorMenuKeyDown">
        @foreach (var color in Enum.GetValues<TaskColor>())
        {
            <button type="button" class="color-menu-option"
                    aria-pressed="@(Item.Color == color ? "true" : "false")"
                    disabled="@Disabled"
                    @onclick="() => SetColorAsync(color)">
                <span class="color-menu-swatch task-color-@color.ToString().ToLowerInvariant()" aria-hidden="true">●</span>
                @color
                @if (Item.Color == color) { <span aria-hidden="true">✓</span> }
            </button>
        }
    </div>
}
</li>

@code {
    [Parameter, EditorRequired] public TodoItem Item { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter, EditorRequired] public Func<int, Task>? OnToggle { get; set; }
    [Parameter, EditorRequired] public Func<int, Task>? OnDelete { get; set; }
    [Parameter, EditorRequired] public Func<int, TaskColor, Task<bool>>? OnSetColor { get; set; }
    [Parameter, EditorRequired] public Func<TodoItem, Task<bool>>? OnSave { get; set; }

    private ElementReference _editor;
    private ElementReference _titleButton;
    private ElementReference _colorMenu;
    private string _editTitle = string.Empty;
    private bool _isEditing;
    private bool _focusEditor;
    private bool _isSaving;
    private bool _showColorMenu;
    private bool _focusColorMenu;
    private bool _returnFocus;
    private double _menuX;
    private double _menuY;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusEditor)
        {
            _focusEditor = false;
            await _editor.FocusAsync();
        }
        if (_focusColorMenu)
        {
            _focusColorMenu = false;
            await _colorMenu.FocusAsync();
        }
        if (_returnFocus)
        {
            _returnFocus = false;
            await _titleButton.FocusAsync();
        }
    }

    private Task ToggleAsync() => OnToggle?.Invoke(Item.Id) ?? Task.CompletedTask;
    private Task DeleteAsync() => OnDelete?.Invoke(Item.Id) ?? Task.CompletedTask;

    private void OpenColorMenu(MouseEventArgs args)
    {
        if (Disabled) return;
        _menuX = Math.Max(0, args.ClientX);
        _menuY = Math.Max(0, args.ClientY);
        _showColorMenu = true;
        _focusColorMenu = true;
    }

    private void CloseColorMenu()
    {
        _showColorMenu = false;
        _returnFocus = true;
    }

    private void HandleColorMenuKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseColorMenu();
    }

    private async Task SetColorAsync(TaskColor color)
    {
        CloseColorMenu();
        if (OnSetColor is not null && color != Item.Color)
        {
            await OnSetColor(Item.Id, color);
        }
    }

    private void HandleTitleClick(MouseEventArgs args)
    {
        if (TaskEditTrigger.ShouldStartEditing(args.Detail))
        {
            StartEditing();
        }
    }

    private void StartEditing()
    {
        if (Disabled)
        {
            return;
        }

        _editTitle = Item.Title;
        _isEditing = true;
        _focusEditor = true;
    }

    private void HandleTitleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "F2")
        {
            StartEditing();
        }
    }

    private async Task HandleEditKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _isEditing = false;
            _editTitle = Item.Title;
            return;
        }

        if (args.Key == "Enter")
        {
            await SaveAsync();
        }
    }

    private async Task SaveOnBlurAsync()
    {
        if (_isEditing)
        {
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_isSaving)
        {
            return;
        }

        var trimmedTitle = _editTitle.Trim();
        if (trimmedTitle.Length == 0)
        {
            _editTitle = Item.Title;
            _isEditing = false;
            return;
        }

        if (trimmedTitle == Item.Title || OnSave is null)
        {
            _isEditing = false;
            return;
        }

        _isSaving = true;
        var editedItem = new TodoItem { Id = Item.Id, Title = trimmedTitle };
        var saved = await OnSave(editedItem);
        _isSaving = false;
        _isEditing = !saved;
        _focusEditor = !saved;
    }
}
